load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "web",
    srcs = [
        "__init__.py",
        "app.py",
        "security.py",
        "sse.py",
        "startup.py",
        "templates.py",
        "tls.py",
        "transcription.py",
    ],
    data = glob(["static/*"]),
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//printer_debugger:init",
        "//printer_debugger/kb",
        "//printer_debugger/store",
        "@pypi//fastapi",
    ],
)

py_test(
    name = "units_test",
    size = "small",
    srcs = ["units_test.py"],
    deps = [":web"],
)

# cryptography is only pulled by the TLS cert-generation path, so its dependency stays on this
# target (and //printer_debugger:main) rather than the shared :web library, keeping the rest of
# the suite from fetching it. ensure_self_signed imports it lazily, so :web needs no such dep.
py_test(
    name = "tls_test",
    size = "small",
    srcs = ["tls_test.py"],
    deps = [
        ":web",
        "@pypi//cryptography",
    ],
)

py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    deps = [
        ":web",
        "@pypi//httpx",
    ],
)

py_test(
    name = "ui_test",
    size = "small",
    srcs = ["ui_test.py"],
    deps = [
        ":web",
        "@pypi//httpx",
    ],
)
