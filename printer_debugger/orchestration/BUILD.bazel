load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "orchestration",
    srcs = [
        "__init__.py",
        "binding.py",
        "gate.py",
        "prompt.py",
        "session_service.py",
        "turn.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//printer_debugger:init",
        "//printer_debugger/store",
    ],
)

[
    py_test(
        name = "%s_test" % name,
        size = "small",
        srcs = ["%s_test.py" % name],
        deps = [":orchestration"],
    )
    for name in [
        "gate",
        "orchestration",
    ]
]
